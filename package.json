{
  "name": "@yarikleto/browser-ts-json-schema-generator",
  "version": "1.0.7",
  "description": "Generate JSON Schema from TypeScript types in the browser (no Node.js / no filesystem).",
  "keywords": [
    "ts",
    "typescript",
    "json",
    "schema",
    "jsonschema",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yarikleto/browser-ts-json-schema-generator.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "factory",
    "index.*"
  ],
  "scripts": {
    "build": "tsc",
    "format": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "npm run build && auto shipit",
    "test": "npm run test:browser && npm run test:node",
    "test:browser": "jest",
    "test:node": "node --test --import tsx test/**/*.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "json5": "^2.2.3",
    "safe-stable-stringify": "^2.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@auto-it/conventional-commits": "^9.10.4",
    "@auto-it/first-time-contributor": "^9.10.4",
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "auto": "^9.10.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.7.3",
    "ts-jest": "^29.2.6",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.48.0"
  },
  "packageManager": "npm@11.6.4"
}
